# Copy to .env and adjust. Do not commit real secrets.

# mock = in-memory data (no Oracle required for UI/API exploration)
# oracle = connect via node-oracledb
DB_MODE=mock

PORT=4000
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Used only when DB_MODE=oracle
ORACLE_USER=hms_app
ORACLE_PASSWORD=change_me
# Easy Connect examples:
#   localhost:1521/XEPDB1
#   localhost:1521/FREEPDB1
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
